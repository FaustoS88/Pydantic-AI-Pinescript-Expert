# Copy to .env (setup.py does it) and fill in your keys. The README explains every variable.

# Required: OpenAI key for the embeddings, and for the answers without OPENROUTER_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional: answers through OpenRouter; the --model presets and --contextual need it
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Optional settings, shown with the defaults from config.py
# PINESCRIPT_MODEL=openai:gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PINESCRIPT_TEMPERATURE=0.2
# PINESCRIPT_MAX_TOKENS=2000
# PINESCRIPT_THINKING_EFFORT=high
# PINESCRIPT_EMBEDDING_MODEL=text-embedding-3-small
# PINESCRIPT_RETRIEVAL_CANDIDATES=15
# PINESCRIPT_SIMILARITY_THRESHOLD=0.3
# PINESCRIPT_HYBRID_ALPHA=0.5
# PINESCRIPT_RERANK_TOP_N=15
# PINESCRIPT_MMR_LAMBDA=0.7
# PINESCRIPT_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# PINESCRIPT_CHUNK_SIZE=1000
# PINESCRIPT_CHUNK_OVERLAP=100
# PINESCRIPT_CONTEXTUAL_MODEL=openai/gpt-4.1-mini
# PINESCRIPT_MAX_PAGE_CONTEXT_CHARS=8000
# PINESCRIPT_VECTOR_SEARCH_LIMIT=8
